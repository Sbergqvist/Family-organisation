# Sikkerhedsheaders til Cloudflare Pages.
# Filen læses automatisk af Pages og gælder alle svar fra siden.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'

# Selve appen må ikke caches hårdt, så rettelser slår igennem med det samme.
/index.html
  Cache-Control: no-cache
